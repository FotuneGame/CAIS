export virtual class EffectsService : IService {
  CounterfactualService counterfactual;
  BootstrapService bootstrap;
  // Для агента i: k траекторий при замене только его; counterfactual — их средний исход;
  // ate = фактический исход − counterfactual; critical — моменты времени шагов, где накопленный исход траектории
  // отличается от фактического больше чем на epsilon (без повторов, по возрастанию);
  // ci — bootstrap.interval(разности награды шага и средней награды траекторий на этом шаге, b, rng).
  virtual Effect[] estimate(History history, CausalModel model, int k, int b, double epsilon, Handler rng);
}
