import "../macie/macie.functions";
import "../../shared/core/types/roles.types";
import "../../shared/core/types/base.types";

export virtual class RandomService : IService {
  // Генератор mulberry32 — функция без аргументов, возвращающая число от 0 до 1:
  // state = seed >>> 0; на каждом вызове state = (state + 0x6d2b79f5) >>> 0; t = state;
  // t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
  // вернуть ((t ^ (t >>> 14)) >>> 0) / 4294967296.
  virtual Handler create(int seed);
  virtual Any pick(Any[] items, Handler rng);
  virtual string sample(Any weights, Handler rng);
}
