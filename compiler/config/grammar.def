%start program ;
%fold statement expression sequence assign ternary or and bitor bitxor bitand equal compare shift sum product unary postfix primary ;

program     : (import | declaration)* END ;
import      : COMMENT* 'virtual'? 'import' STRING ';' ;
declaration : COMMENT* 'export'? (typedef | enum | interface | class | function | variable) ;

typedef     : 'typedef' type IDENT ';' ;
enum        : 'enum' IDENT '{' enumerator (',' enumerator)* ','? '}' ;
enumerator  : COMMENT* IDENT ('=' expression)? ;
interface   : modifier* 'interface' IDENT generics? bases? ('{' member* '}' | ';') ;
class       : modifier* 'class' IDENT generics? bases? ('{' member* '}' | ';') ;
generics    : '<' IDENT (',' IDENT)* '>' ;
bases       : ':' base (',' base)* ;
base        : ('public' | 'private' | 'protected')? type ;
member      : COMMENT* modifier* (constructor | method | field) ;
constructor : IDENT '(' params? ')' super? block ;
super       : ':' 'base' '(' args? ')' ;
method      : type IDENT '(' params? ')' (block | ';') | IDENT '(' params? ')' ';' ;
field       : type IDENT ('=' expression)? ';' ;
function    : modifier* type IDENT '(' params? ')' (block | ';') ;
variable    : modifier* type IDENT ('=' expression)? ';' ;
modifier    : 'public' | 'private' | 'protected' | 'static' | 'virtual' | 'override' | 'async' | 'const' ;
params      : param (',' param)* ;
param       : modifier* type IDENT ('=' expression)? ;

type        : typename ('<' type (',' type)* '>')? array* optional? ;
target      : typename ('<' type (',' type)* '>')? array* ;
typename    : basic+ | named | IDENT ;
basic       : 'unsigned' | 'signed' | 'char' | 'short' | 'int' | 'long' | 'float' | 'double' | 'void' ;
named       : 'bool' | 'string' | 'date' | 'promise' ;
array       : '[' ']' ;
optional    : '?' ;

block       : '{' statement* '}' ;
statement   : note | block | if | while | dowhile | for | switch | return | break | continue | throw | try | delete | local | exprstmt | empty ;
note        : COMMENT ;
empty       : ';' ;
if          : 'if' '(' expression ')' statement else? ;
else        : 'else' statement ;
while       : 'while' '(' expression ')' statement ;
dowhile     : 'do' statement 'while' '(' expression ')' ';' ;
for         : 'for' '(' forinit forcond forstep ')' statement ;
forinit     : local | exprstmt | ';' ;
forcond     : expression? ';' ;
forstep     : sequence? ;
switch      : 'switch' '(' expression ')' '{' case* '}' ;
case        : ('case' expression | 'default') ':' statement* ;
return      : 'return' expression? ';' ;
break       : 'break' ';' ;
continue    : 'continue' ';' ;
throw       : 'throw' expression ';' ;
try         : 'try' block catch* finally? ;
catch       : 'catch' '(' type IDENT ')' block ;
finally     : 'finally' block ;
delete      : 'delete' expression ';' ;
local       : modifier* type IDENT ('=' expression)? ';' ;
exprstmt    : sequence ';' ;
sequence    : expression (',' expression)* ;

expression  : assign ;
assign      : ternary (('=' | '+=' | '-=' | '*=' | '/=' | '%=' | '<<=' | '>>=' | '&=' | '^=' | '|=') assign)? ;
ternary     : or ('?' expression ':' ternary)? ;
or          : and ('||' and)* ;
and         : bitor ('&&' bitor)* ;
bitor       : bitxor ('|' bitxor)* ;
bitxor      : bitand ('^' bitand)* ;
bitand      : equal ('&' equal)* ;
equal       : compare (('==' | '!=') compare)* ;
compare     : shift (('<=' | '>=' | '<' | '>') shift | ('is' | 'as') target)* ;
shift       : sum (('<<' | '>>') sum)* ;
sum         : product (('+' | '-') product)* ;
product     : unary (('*' | '/' | '%') unary)* ;
unary       : ('++' | '--' | '!' | '~' | '-' | '+' | 'await') unary | cast | postfix ;
cast        : '(' (basic+ | named) array* ')' unary ;
postfix     : primary (call | index | access | '++' | '--')* ;
call        : '(' args? ')' ;
index       : '[' expression ']' ;
access      : '.' IDENT ;
args        : expression (',' expression)* ;
primary     : INT | FLOAT | CHAR | STRING | 'null' | 'true' | 'false' | 'this' | 'base' | creation | size | IDENT | '(' expression ')' | initializer ;
creation    : 'new' target (call | index) ;
size        : 'sizeof' '(' (type ')' | expression ')') ;
initializer : '{' args? '}' ;
